{
	"schemaVersion": 1,
	"id": "universemod",
	"version": "${version}",
	"name": "UniverseMod",
	"description": "Travel a procedural universe: every star is a Minecraft seed.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/universemod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"arsqz.mod.TwoSixTwo_Arskiz"
		],
		"client": [
			"arsqz.mod.client.TwoSixTwo_ArskizClient"
		],
		"fabric-datagen": [
			"arsqz.mod.client.TwoSixTwo_ArskizDataGenerator"
		]
	},
	"mixins": [
		"universemod.mixins.json",
		{
			"config": "universemod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
